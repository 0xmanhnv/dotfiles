# ==============================================================================
# .zshrc — pure zsh + Starship + selective plugins (no oh-my-zsh framework)
#
# Layout:
#   ~/.zshrc                 this loader (history, completion, plugins, prompt)
#   ~/.config/zsh/*.zsh      env, PATH, tool init, aliases (modular by topic/OS)
#   ~/.zshrc.local           machine-specific overrides (not tracked)
#
# Plugins are git-cloned by run_once_before_02-install-zsh-plugins.sh into:
#   ~/.local/share/zsh/plugins/<name>/<name>.zsh
# ==============================================================================

# === Banner ===
GREEN="\033[1;32m"; YELLOW="\033[1;33m"; RED="\033[1;31m"; RESET="\033[0m"
cat <<'EOF'
                                               _oo0oo_
                                              o8888888o
                                              88" . "88
                                              (| -_- |)
                                              0\  =  /0
                                            ___/`---'\___
                                          .' \|     |// '.
                                         / \|||  :  |||// \
                                        / _||||| -:- |||||- \
                                       |   | \  -  /// |   |
                                       | \_|  ''\---/''  |_/ |
                                       \  .-\__  '-'  ___/-. /
                                     ___'. .'  /--.--\  `. .'___
                                  ."" '<  `.___\_<|>_/___.' >' "".
                                 | | :  `- \`.;`\ _ /`;.`/ - ` : | |
                                 \  \ `_.   \_ __\ /__ _/   .-` /  /
                             =====`-.____`.___ \_____/___.-`___.-'=====
                                               `=---='

                             ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
EOF
echo -e "                                ${GREEN}Buddha Bless:${RESET} ${RED}Critical ${YELLOW}Bugs Incoming${RESET}"

# === History ===
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=50000
export SAVEHIST=50000
setopt EXTENDED_HISTORY HIST_EXPIRE_DUPS_FIRST HIST_IGNORE_DUPS HIST_IGNORE_SPACE
setopt HIST_VERIFY SHARE_HISTORY INC_APPEND_HISTORY

# === Directory navigation ===
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS

# === Completion (cached daily for fast startup) ===
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# === Keybindings ===
bindkey -e   # emacs-style

# === Base PATH (modular config below may extend) ===
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

# === Modular config (env, PATH, tools, aliases — see ~/.config/zsh/) ===
() {
  setopt local_options null_glob
  for f in "$HOME/.config/zsh/"*.zsh; do
    source "$f"
  done
}

# === Plugins ===
# Order matters:
#   1. zsh-autosuggestions    — must come before syntax-highlighting
#   2. fzf-tab                — must come BEFORE syntax-highlighting (its README)
#   3. zsh-syntax-highlighting
#   4. zsh-history-substring-search — must come AFTER syntax-highlighting
ZSH_PLUGINS_DIR="${ZSH_PLUGINS_DIR:-$HOME/.local/share/zsh/plugins}"

# Async + buffer cap: keep zle responsive on slow terminals (code-server's
# xterm.js, SSH over high-RTT links, low-CPU boxes). Async runs the lookup
# in a forked subshell via zsh/zpty so each keystroke doesn't block the
# editor; the buffer cap stops suggesting once the input passes 20 chars,
# where lookups get expensive and the suggestion is rarely useful.
export ZSH_AUTOSUGGEST_USE_ASYNC=1
export ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20

[[ -s "$ZSH_PLUGINS_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
  source "$ZSH_PLUGINS_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"

if [[ -s "$ZSH_PLUGINS_DIR/fzf-tab/fzf-tab.plugin.zsh" ]]; then
  source "$ZSH_PLUGINS_DIR/fzf-tab/fzf-tab.plugin.zsh"

  # fzf-tab UX styling — preview cd targets / files / processes / git refs.
  # Falls back gracefully when the preview tool (eza, bat) isn't installed.
  zstyle ':fzf-tab:*' fzf-bindings 'tab:accept'
  zstyle ':fzf-tab:*' use-fzf-default-opts yes
  zstyle ':fzf-tab:*' switch-group ',' '.'
  zstyle ':completion:*:descriptions' format '[%d]'
  # nerd_font flag controls --icons in eza previews. Without Nerd Font the
  # glyphs render as boxes inside the fzf preview pane.
{{- if .nerd_font }}
  zstyle ':fzf-tab:complete:cd:*' \
    fzf-preview 'eza -1 --color=always --icons "$realpath" 2>/dev/null || ls -1 "$realpath"'
  zstyle ':fzf-tab:complete:__zoxide_z:*' \
    fzf-preview 'eza -1 --color=always --icons "$realpath" 2>/dev/null || ls -1 "$realpath"'
  zstyle ':fzf-tab:complete:*:*' \
    fzf-preview 'bat --color=always --line-range :50 "$realpath" 2>/dev/null \
                 || eza -1 --color=always --icons "$realpath" 2>/dev/null \
                 || cat "$realpath" 2>/dev/null'
{{- else }}
  zstyle ':fzf-tab:complete:cd:*' \
    fzf-preview 'eza -1 --color=always "$realpath" 2>/dev/null || ls -1 "$realpath"'
  zstyle ':fzf-tab:complete:__zoxide_z:*' \
    fzf-preview 'eza -1 --color=always "$realpath" 2>/dev/null || ls -1 "$realpath"'
  zstyle ':fzf-tab:complete:*:*' \
    fzf-preview 'bat --color=always --line-range :50 "$realpath" 2>/dev/null \
                 || eza -1 --color=always "$realpath" 2>/dev/null \
                 || cat "$realpath" 2>/dev/null'
{{- end }}
  zstyle ':fzf-tab:complete:(kill|ps):argument-rest' \
    fzf-preview 'ps -o pid,cmd -p $word 2>/dev/null'
  zstyle ':fzf-tab:complete:git-(add|diff|restore):*' \
    fzf-preview 'git diff --color=always -- "$realpath" 2>/dev/null | head -200'
  zstyle ':fzf-tab:complete:git-(checkout|switch|branch):*' \
    fzf-preview 'git log --color=always --oneline --graph -20 "$word" 2>/dev/null'
fi

{{- if not .slow_terminal }}
[[ -s "$ZSH_PLUGINS_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
  source "$ZSH_PLUGINS_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
{{- else }}
# slow_terminal=true: skip zsh-syntax-highlighting. It's a synchronous zle
# widget that re-parses the entire buffer on every keystroke — the worst
# offender for typing-lag and char-doubling on web/SSH terminals where
# WebSocket / network round-trips compound the per-keystroke cost.
{{- end }}

if [[ -s "$ZSH_PLUGINS_DIR/zsh-history-substring-search/zsh-history-substring-search.zsh" ]]; then
  source "$ZSH_PLUGINS_DIR/zsh-history-substring-search/zsh-history-substring-search.zsh"
  bindkey '^[[A' history-substring-search-up    # Up arrow
  bindkey '^[[B' history-substring-search-down  # Down arrow
  bindkey '^P'   history-substring-search-up    # Ctrl-P
  bindkey '^N'   history-substring-search-down  # Ctrl-N
fi

# === Prompt: Starship ===
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# === Machine-specific overrides (not tracked) ===
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
