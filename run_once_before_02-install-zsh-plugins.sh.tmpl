#!/usr/bin/env bash
# Install standalone zsh plugins (no oh-my-zsh framework).
# Plugins are sourced from ~/.zshrc; they live at:
#   ~/.local/share/zsh/plugins/<name>/<name>.zsh
# Runs AFTER 01-install-packages so git is available.
set -euo pipefail

PLUGIN_DIR="$HOME/.local/share/zsh/plugins"
mkdir -p "$PLUGIN_DIR"

# bash 3.2 compatible — no associative arrays
plugins=(
  "zsh-autosuggestions          https://github.com/zsh-users/zsh-autosuggestions.git"
  "zsh-syntax-highlighting      https://github.com/zsh-users/zsh-syntax-highlighting.git"
  "zsh-history-substring-search https://github.com/zsh-users/zsh-history-substring-search.git"
)

for entry in "${plugins[@]}"; do
  name="${entry%% *}"
  url="${entry##* }"
  dest="$PLUGIN_DIR/$name"
  if [[ ! -d "$dest" ]]; then
    echo "==> Cloning zsh plugin: $name"
    git clone --depth=1 "$url" "$dest"
  fi
done
