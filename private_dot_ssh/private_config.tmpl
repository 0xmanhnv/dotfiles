# Host-specific entries (internal IPs, custom IdentityFiles, work-only hosts)
# live in ~/.ssh/config.local, which is NOT tracked by chezmoi. Create it on
# each machine with your real hosts. Include comes FIRST so per-host
# directives win over the catch-all below (ssh_config "first match wins").
#
# Example ~/.ssh/config.local:
#
#   Host myserver
#       HostName 10.0.0.5
#       User admin
#       IdentityFile ~/.ssh/id_ed25519
#
# Missing config.local is non-fatal on OpenSSH 7.3+ (silently skipped).
{{- if eq .chezmoi.os "darwin" }}
# UseKeychain is an Apple-OpenSSH-only option; a Homebrew / MacPorts ssh
# would refuse the whole file without this.
IgnoreUnknown UseKeychain
{{- end }}
Include config.local

# Catch-all secure defaults — applied to any host not matched in config.local.
Host *
	AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
	UseKeychain yes
{{- end }}
	ServerAliveInterval 60
	ServerAliveCountMax 3
	HashKnownHosts yes
	# Offer only the key(s) configured for the host (IdentityFile, or the
	# default id_* files), not every key loaded in the agent. With several
	# keys in the agent, servers otherwise hit MaxAuthTries (default 6) and
	# drop you with "Too many authentication failures".
	IdentitiesOnly yes
	# Connection sharing: the 2nd+ ssh / scp / git to the same host reuses
	# the first TCP+auth session, so it opens instantly. The master stays
	# up 10 min after the last session closes. %C = hash of host/port/user
	# (keeps the socket path under the 104-byte limit). `ssh -O exit <host>`
	# drops a stale master.
	ControlMaster auto
	ControlPath ~/.ssh/cm-%C
	ControlPersist 10m
