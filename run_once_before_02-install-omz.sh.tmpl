#!/usr/bin/env bash
# Install oh-my-zsh and the external plugins referenced in dot_zshrc.
# Built-in OMZ plugins (`git`, `history-substring-search`) need no install.
# Runs BEFORE 01-install-packages so OMZ is ready when zsh first launches.
set -euo pipefail

# 1. oh-my-zsh
if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
  echo "==> Installing oh-my-zsh"
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/HEAD/tools/install.sh)"
fi

# 2. External plugins (bash 3.2 compatible — no associative arrays)
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

plugins=(
  "zsh-autosuggestions https://github.com/zsh-users/zsh-autosuggestions.git"
  "zsh-syntax-highlighting https://github.com/zsh-users/zsh-syntax-highlighting.git"
)

for entry in "${plugins[@]}"; do
  name="${entry%% *}"
  url="${entry##* }"
  dest="$ZSH_CUSTOM/plugins/$name"
  if [[ ! -d "$dest" ]]; then
    echo "==> Cloning OMZ plugin: $name"
    git clone --depth=1 "$url" "$dest"
  fi
done
