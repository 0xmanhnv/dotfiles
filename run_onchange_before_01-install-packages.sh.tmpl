#!/usr/bin/env bash
# run_onchange_: chezmoi re-runs this whenever its rendered content changes.
# The hashes below embed the package lists for this OS, so editing Brewfile
# (or packages/*.txt) re-installs on the next `chezmoi apply` — not only on
# the very first one. Every installer below is idempotent.
{{ if eq .chezmoi.os "darwin" -}}
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
{{ if .pentest -}}
# Brewfile.pentest hash: {{ include "Brewfile.pentest" | sha256sum }}
{{ end -}}
{{ else if eq .chezmoi.os "linux" -}}
{{ range list "apt" "dnf" "pacman" -}}
# packages/{{ . }}.txt hash: {{ include (printf "packages/%s.txt" .) | sha256sum }}
{{ if $.pentest -}}
# packages/{{ . }}.pentest.txt hash: {{ include (printf "packages/%s.pentest.txt" .) | sha256sum }}
{{ end -}}
{{ end -}}
{{ end -}}
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
echo "==> Installing Homebrew packages"
if ! command -v brew >/dev/null 2>&1; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if [[ "$(uname -m)" == "arm64" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  eval "$(/usr/local/bin/brew shellenv)"
fi

# --no-upgrade: a re-run because one line was added to the Brewfile should
# install what's missing, not upgrade every formula (`brew upgrade` does that).
brew bundle --no-upgrade --file="{{ .chezmoi.sourceDir }}/Brewfile"
{{ if .pentest -}}
echo "==> Installing pentest toolkit (pentest flag = true)"
brew bundle --no-upgrade --file="{{ .chezmoi.sourceDir }}/Brewfile.pentest"
{{ end -}}
{{ else if eq .chezmoi.os "linux" -}}
echo "==> Installing Linux packages"

# If Docker is already installed (e.g., user installed Docker CE from
# download.docker.com), skip our distro-package Docker entries. Docker CE's
# `containerd.io` conflicts with `docker.io`'s `containerd` dep, so apt
# can't resolve them together. Same conflict shape on Fedora/Arch with
# moby-engine vs. docker-ce.
DOCKER_PRESENT=0
if command -v docker >/dev/null 2>&1; then
  DOCKER_PRESENT=1
  echo "==> Docker already present ($(docker --version 2>/dev/null | head -1)) — skipping distro Docker pkgs"
fi
is_docker_pkg() {
  case "$1" in
    docker|docker.io|docker-compose|docker-compose-v2|docker-buildx|moby-engine) return 0 ;;
    *) return 1 ;;
  esac
}

if [[ -f /etc/debian_version ]]; then
  # NodeSource only for Ubuntu/Debian proper — apt's nodejs there is typically
  # v18, way too old. Kali/Parrot are rolling-release Debian derivatives that
  # already ship Node 24+ in their default repos, and NodeSource's setup script
  # doesn't officially target them.
  if grep -qiE '^ID=(ubuntu|debian)$' /etc/os-release 2>/dev/null && \
     ! ls /etc/apt/sources.list.d/nodesource* >/dev/null 2>&1; then
    echo "==> Setting up NodeSource (Node 24 LTS)"
    curl -fsSL https://deb.nodesource.com/setup_24.x | sudo -E bash -
  fi

  # GitHub CLI: not in default Debian/Ubuntu/Kali apt repos. Add the official
  # cli.github.com apt source before installing. Gate on BOTH the keyring and
  # the .list file so re-running after partial cleanup (e.g. user deleted just
  # the keyring) re-creates whatever is missing rather than silently leaving
  # apt with a dangling signed-by reference.
  if [[ ! -f /etc/apt/keyrings/githubcli-archive-keyring.gpg \
     || ! -f /etc/apt/sources.list.d/github-cli.list ]]; then
    echo "==> Setting up GitHub CLI apt repo"
    sudo mkdir -p -m 755 /etc/apt/keyrings
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | \
      sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
    sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | \
      sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
  fi

  sudo apt-get update

  # apt-get install is all-or-nothing: a single missing package aborts the
  # whole batch and skips even the available ones. Split apt.txt into packages
  # the configured repos can resolve vs. the rest, then install the resolvable
  # set in one shot and hand the rest to fallback installers below. Debian 12
  # / Parrot 6 / Kali don't carry eza, zoxide, yq, or openjdk-21 in default
  # repos — those need out-of-band installs.
  # apt-cache policy is the right tool here: a package can be referenced by
  # other packages' Depends without having an installation candidate in this
  # release (e.g. neovim got pulled from Parrot lory but is still mentioned in
  # the package graph). `apt-cache show` returns 0 for those phantom entries,
  # so we'd misclassify them as available and the batch install would still
  # abort. `apt-cache policy` reports `Candidate: (none)` for them.
  apt_list="{{ .chezmoi.sourceDir }}/packages/apt.txt"
  available=()
  missing=()
  while IFS= read -r pkg; do
    [[ -z "$pkg" || "$pkg" =~ ^[[:space:]]*# ]] && continue
    (( DOCKER_PRESENT )) && is_docker_pkg "$pkg" && continue
    # Don't `exit` from awk on first match: awk would close its stdin,
    # apt-cache would receive SIGPIPE on its next write, and pipefail+set -e
    # would abort the whole script with exit 141. apt-cache policy emits
    # exactly one Candidate line per package, so reading the rest is cheap.
    candidate="$(apt-cache policy "$pkg" 2>/dev/null \
      | awk '/^[[:space:]]+Candidate:/ {print $2}')"
    if [[ -n "$candidate" && "$candidate" != "(none)" ]]; then
      available+=("$pkg")
    else
      missing+=("$pkg")
    fi
  done < "$apt_list"

  if (( ${#available[@]} > 0 )); then
    sudo apt-get install -y "${available[@]}"
  fi
  if (( ${#missing[@]} > 0 )); then
    echo "==> Not in apt repos on this distro: ${missing[*]} — using fallback installers"
  fi

{{ if .pentest -}}
  echo "==> Installing pentest toolkit (pentest flag = true)"
  pentest_list="{{ .chezmoi.sourceDir }}/packages/apt.pentest.txt"
  pentest_available=()
  while IFS= read -r pkg; do
    [[ -z "$pkg" || "$pkg" =~ ^[[:space:]]*# ]] && continue
    candidate="$(apt-cache policy "$pkg" 2>/dev/null \
      | awk '/^[[:space:]]+Candidate:/ {print $2}')"
    if [[ -n "$candidate" && "$candidate" != "(none)" ]]; then
      pentest_available+=("$pkg")
    else
      echo "==> Pentest pkg $pkg not in apt — install manually (try Kali repo or pipx)"
    fi
  done < "$pentest_list"
  if (( ${#pentest_available[@]} > 0 )); then
    sudo apt-get install -y "${pentest_available[@]}"
  fi
{{ end -}}

  is_missing() {
    local p="$1" m
    for m in ${missing[@]+"${missing[@]}"}; do
      [[ "$m" == "$p" ]] && return 0
    done
    return 1
  }

  # eza fallback: upstream-packaged apt repo (deb.gierens.de). Only added to
  # Debian main in trixie/13, so Debian 12 / Parrot / Kali / older Ubuntu
  # need this.
  if is_missing eza && ! command -v eza >/dev/null 2>&1; then
    echo "==> Installing eza from deb.gierens.de"
    sudo mkdir -p -m 755 /etc/apt/keyrings
    curl -fsSL https://raw.githubusercontent.com/eza-community/eza/main/deb.asc | \
      sudo gpg --batch --yes --dearmor -o /etc/apt/keyrings/gierens.gpg
    echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] https://deb.gierens.de stable main" | \
      sudo tee /etc/apt/sources.list.d/gierens.list >/dev/null
    sudo chmod 644 /etc/apt/keyrings/gierens.gpg /etc/apt/sources.list.d/gierens.list
    sudo apt-get update
    sudo apt-get install -y eza
  fi

  # zoxide fallback: official install script. Lands in /usr/local/bin so it's
  # on PATH for every shell.
  if is_missing zoxide && ! command -v zoxide >/dev/null 2>&1; then
    echo "==> Installing zoxide from official install script"
    curl -fsSL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh \
      -o /tmp/zoxide-install.sh
    sudo sh /tmp/zoxide-install.sh --bin-dir /usr/local/bin
    rm -f /tmp/zoxide-install.sh
  fi

  # yq: mikefarah/yq Go binary from GitHub releases. Deliberately NOT in
  # apt.txt — Debian/Ubuntu's `yq` package is kislyuk's Python jq wrapper
  # (different syntax), not the Go tool the Brewfile / dnf install.
  if ! yq --version 2>/dev/null | grep -qi mikefarah; then
    echo "==> Installing yq from GitHub releases"
    yq_arch="$(dpkg --print-architecture)"
    case "$yq_arch" in
      armhf) yq_arch=arm ;;
    esac
    sudo curl -fsSL \
      "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${yq_arch}" \
      -o /usr/local/bin/yq
    sudo chmod +x /usr/local/bin/yq
  fi

  # Debian-family ships bat as `batcat` and fd as `fdfind` (name clashes
  # with older packages). Link the expected names into ~/.local/bin, which
  # ~/.zshrc puts on PATH, so aliases / fzf-tab previews / scripts find them.
  mkdir -p "$HOME/.local/bin"
  for pair in batcat:bat fdfind:fd; do
    src="${pair%%:*}" dst="${pair##*:}"
    if command -v "$src" >/dev/null 2>&1 && ! command -v "$dst" >/dev/null 2>&1; then
      ln -sf "$(command -v "$src")" "$HOME/.local/bin/$dst"
    fi
  done

  # Debian's nodejs only *suggests* npm, and NodeSource (which bundles it)
  # is skipped on Kali/Parrot. Mason needs npm for vtsls / pyright /
  # prettier. Not in apt.txt: NodeSource's nodejs conflicts with apt's npm.
  if command -v node >/dev/null 2>&1 && ! command -v npm >/dev/null 2>&1; then
    echo "==> Installing npm (not bundled with this distro's nodejs)"
    sudo apt-get install -y npm
  fi

  # openjdk-21 fallback: distros that don't ship the explicit -21 metapackage
  # (Debian 12, Parrot 6, Kali 2024.x) get default-jdk instead.
  if is_missing openjdk-21-jdk && ! command -v javac >/dev/null 2>&1; then
    echo "==> openjdk-21-jdk not in apt — installing default-jdk"
    sudo apt-get install -y default-jdk
  fi

  # neovim fallback: follow the upstream pre-built tarball recipe from
  # https://neovim.io/doc/install/ verbatim — extract to /opt and let the
  # PATH entry in dot_config/zsh/40-linux.zsh pick it up.
  #
  # Trigger conditions (any one):
  #   - apt has no candidate at all (Parrot lory ships nvim metadata without
  #     an installable version)
  #   - apt's version is < 0.11.2, the minimum LazyVim (dot_config/nvim/)
  #     starts on. Ubuntu 24.04 ships 0.9.5, Debian 13 / Ubuntu 25.10 0.10.4.
  case "$(uname -m)" in
    x86_64) nvim_arch=x86_64 ;;
    aarch64|arm64) nvim_arch=arm64 ;;
    *) nvim_arch="" ;;
  esac

  nvim_min=0.11.2
  nvim_too_old=0
  if ! is_missing neovim && command -v nvim >/dev/null 2>&1; then
    nvim_ver="$(nvim --version 2>/dev/null | awk 'NR==1 {sub(/^v/,"",$2); print $2}')"
    if [[ -n "$nvim_ver" ]] && \
       [[ "$(printf '%s\n' "$nvim_min" "$nvim_ver" | sort -V | head -1)" != "$nvim_min" ]]; then
      echo "==> apt's neovim ($nvim_ver) is older than $nvim_min — installing tarball alongside"
      nvim_too_old=1
    fi
  fi

  if [[ -n "$nvim_arch" ]] && \
     { is_missing neovim || (( nvim_too_old )); } && \
     [[ ! -x "/opt/nvim-linux-${nvim_arch}/bin/nvim" ]]; then
    echo "==> Installing neovim from upstream tarball (neovim.io recipe)"
    tmp="$(mktemp -d)"
    curl -fsSL \
      "https://github.com/neovim/neovim/releases/latest/download/nvim-linux-${nvim_arch}.tar.gz" \
      -o "$tmp/nvim.tar.gz"
    sudo rm -rf "/opt/nvim-linux-${nvim_arch}"
    sudo tar -C /opt -xzf "$tmp/nvim.tar.gz"
    rm -rf "$tmp"
  elif is_missing neovim && [[ -z "$nvim_arch" ]]; then
    echo "WARNING: arch $(uname -m) unsupported for neovim tarball — install manually" >&2
  fi
elif [[ -f /etc/arch-release ]]; then
  mapfile -t pac_pkgs < <(grep -v '^\s*#' "{{ .chezmoi.sourceDir }}/packages/pacman.txt" | grep .)
  if (( DOCKER_PRESENT )); then
    mapfile -t pac_pkgs < <(printf '%s\n' "${pac_pkgs[@]}" | grep -vxE 'docker|docker-compose|docker-buildx')
  fi
  # -Syu, never bare -Sy: syncing the db without upgrading is a partial
  # upgrade, which Arch doesn't support (breaks on the next soname bump).
  sudo pacman -Syu --noconfirm --needed "${pac_pkgs[@]}"
{{ if .pentest -}}
  echo "==> Installing pentest toolkit (pentest flag = true)"
  mapfile -t pac_pentest < <(grep -v '^\s*#' "{{ .chezmoi.sourceDir }}/packages/pacman.pentest.txt" | grep .)
  sudo pacman -S --noconfirm --needed "${pac_pentest[@]}" || \
    echo "==> Some pentest pacman pkgs unavailable — consider BlackArch overlay"
{{ end -}}
elif [[ -f /etc/fedora-release ]]; then
  # --skip-unavailable: don't fail the whole transaction if a single package
  # has been renamed / removed in this Fedora release (common for the
  # rolling-name java-XX-openjdk-devel formulas).
  mapfile -t dnf_pkgs < <(grep -v '^\s*#' "{{ .chezmoi.sourceDir }}/packages/dnf.txt" | grep .)
  if (( DOCKER_PRESENT )); then
    mapfile -t dnf_pkgs < <(printf '%s\n' "${dnf_pkgs[@]}" | grep -vxE 'moby-engine|docker-compose')
  fi
  sudo dnf install -y --skip-unavailable "${dnf_pkgs[@]}"
{{ if .pentest -}}
  echo "==> Installing pentest toolkit (pentest flag = true)"
  mapfile -t dnf_pentest < <(grep -v '^\s*#' "{{ .chezmoi.sourceDir }}/packages/dnf.pentest.txt" | grep .)
  sudo dnf install -y --skip-unavailable "${dnf_pentest[@]}"
{{ end -}}
fi

# --- Fallbacks for every distro ---------------------------------------------
# Tools that some distro repos lack (or that --skip-unavailable silently
# dropped): checked by command name, so whichever branch ran above, they end
# up installed. Fedora, for one, packages neither starship nor lazygit.
{
  if ! command -v starship >/dev/null 2>&1; then
    echo "==> Installing starship (official install script)"
    curl --proto '=https' --tlsv1.2 -sSfL https://starship.rs/install.sh | sh -s -- --yes
  fi

  # lazygit + glow: not in Debian/Ubuntu/Kali apt repos, nor Fedora's. Pull from GitHub
  # releases — single static binary inside a tarball each. Layout differs
  # per project (lazygit's binary is at archive root; glow's is nested in a
  # versioned subdir), so extract the whole tarball into a temp dir and
  # find the binary by name.
  #
  # Version resolution: follow the redirect on /releases/latest instead of
  # hitting api.github.com. GitHub's unauthenticated REST API allows 60
  # req/hour per IP, and CI runners share IPs — exceeded quotas return 403
  # and break the bootstrap. The HTML redirect endpoint has no such limit.
  install_github_tarball_binary() {
    local repo="$1" binary="$2" arch
    arch="$(uname -m)"
    case "$arch" in
      aarch64|arm64) arch=arm64 ;;
      x86_64|amd64)  arch=x86_64 ;;
    esac
    local final_url ver
    final_url="$(curl -fsSLI -o /dev/null -w '%{url_effective}' \
      "https://github.com/${repo}/releases/latest")"
    ver="$(echo "$final_url" | sed -E 's|.*/v?([^/]+)$|\1|')"
    if [[ -z "$ver" || "$ver" == "$final_url" ]]; then
      echo "WARNING: couldn't resolve latest version for $repo — skipping" >&2
      return 0
    fi
    local tmp; tmp="$(mktemp -d)"
    curl -fsSL \
      "https://github.com/${repo}/releases/download/v${ver}/${binary}_${ver}_Linux_${arch}.tar.gz" \
      -o "$tmp/x.tar.gz"
    tar -xzf "$tmp/x.tar.gz" -C "$tmp"
    local found
    found="$(find "$tmp" -type f -name "$binary" | head -1)"
    if [[ -z "$found" ]]; then
      echo "WARNING: $binary not found in extracted tarball — skipping" >&2
      rm -rf "$tmp"
      return 0
    fi
    sudo install -m 0755 "$found" "/usr/local/bin/$binary"
    rm -rf "$tmp"
  }

  if ! command -v lazygit >/dev/null 2>&1; then
    echo "==> Installing lazygit from GitHub releases"
    install_github_tarball_binary jesseduffield/lazygit lazygit
  fi
  if ! command -v glow >/dev/null 2>&1; then
    echo "==> Installing glow from GitHub releases"
    install_github_tarball_binary charmbracelet/glow glow
  fi

  # delta (git pager, wired in ~/.gitconfig): Debian 12 has no git-delta
  # package. Without it `git add -p` fails ("mismatched output from
  # interactive.diffFilter"). Tag has no "v"; musl build = no glibc floor.
  if ! command -v delta >/dev/null 2>&1; then
    echo "==> Installing delta from GitHub releases"
    case "$(uname -m)" in
      x86_64|amd64)  delta_target=x86_64-unknown-linux-musl ;;
      aarch64|arm64) delta_target=aarch64-unknown-linux-gnu ;;
      *)             delta_target="" ;;
    esac
    delta_ver="$(curl -fsSLI -o /dev/null -w '%{url_effective}' \
      https://github.com/dandavison/delta/releases/latest | sed -E 's|.*/||')"
    if [[ -n "$delta_target" && -n "$delta_ver" ]]; then
      tmp="$(mktemp -d)"
      curl -fsSL "https://github.com/dandavison/delta/releases/download/${delta_ver}/delta-${delta_ver}-${delta_target}.tar.gz" \
        | tar -xz -C "$tmp"
      sudo install -m 0755 "$tmp/delta-${delta_ver}-${delta_target}/delta" /usr/local/bin/delta
      rm -rf "$tmp"
    else
      echo "WARNING: couldn't resolve a delta build for $(uname -m) — skipping" >&2
    fi
  fi
}

# --- Docker post-install (Linux, real hosts only) --------------------------
# Skip in Docker / CI containers — there's no systemd to enable, and adding
# root (the typical container user) to the docker group is meaningless.
# Real hosts: enable docker.service and add the current user to the docker
# group so `docker` runs without sudo. Re-login or `newgrp docker` to apply.
if [[ ! -f /.dockerenv ]] && [[ "${CI:-}" != "true" ]] \
   && command -v docker >/dev/null 2>&1 \
   && command -v systemctl >/dev/null 2>&1; then
  if systemctl list-unit-files docker.service >/dev/null 2>&1 \
     && ! systemctl is-enabled --quiet docker.service; then
    echo "==> Enabling docker.service"
    sudo systemctl enable --now docker.service || true
  fi
  # id -un works whether $USER is set or not (set -u doesn't trip on it).
  docker_user="$(id -un)"
  if [[ "$docker_user" != "root" ]] \
     && ! id -nG "$docker_user" | tr ' ' '\n' | grep -qx docker; then
    echo "==> Adding $docker_user to docker group (re-login or 'newgrp docker' to apply)"
    sudo usermod -aG docker "$docker_user" || true
  fi
fi

{{ if and .nerd_font (ne .profile "server") -}}
# JetBrainsMono Nerd Font — starship's prompt and eza's --icons need Nerd
# Font glyphs (the boxes you see otherwise are unrenderable codepoints).
# Brewfile installs font-jetbrains-mono-nerd-font on macOS; on Linux pull
# the same family from the upstream Nerd Fonts release. Per-user install
# (no sudo), discovered automatically by fontconfig from ~/.local/share/fonts.
# Don't forget to also set the font in your terminal emulator.
nf_dir="$HOME/.local/share/fonts/JetBrainsMonoNerdFont"
if ! ls "$nf_dir"/*.ttf >/dev/null 2>&1; then
  echo "==> Installing JetBrainsMono Nerd Font to $nf_dir"
  mkdir -p "$nf_dir"
  tmp="$(mktemp -d)"
  curl -fsSL \
    "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip" \
    -o "$tmp/font.zip"
  unzip -q -o "$tmp/font.zip" -d "$nf_dir"
  rm -rf "$tmp"
  if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f "$nf_dir" >/dev/null 2>&1 || true
  fi
  echo "==> Set your terminal font to 'JetBrainsMono Nerd Font' to render starship/eza icons"
fi
{{ end -}}
{{- end }}
