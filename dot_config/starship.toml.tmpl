"$schema" = 'https://starship.rs/config-schema.json'

# Custom Catppuccin preset — info-rich but no segment backgrounds.
# Multi-line layout, foreground colors only, palette = Catppuccin Mocha.
# Always-on info: OS icon, user, hostname (when SSH), directory, time.
# Context-aware: git, language version, docker, conda, cmd duration, exit status.

palette = 'catppuccin_mocha'

format = """
$os \
$username\
$hostname\
$directory\
$git_branch\
$git_status\
$nodejs$bun$python$rust$golang$java$kotlin$haskell$php$c\
$docker_context\
$conda\
$cmd_duration\
$time \
$character"""

add_newline = true

[os]
disabled = false
style = "fg:peach"
format = '[$symbol]($style)'

[os.symbols]
{{- if .nerd_font }}
Macos = "󰀵"
Linux = "󰌽"
Ubuntu = "󰕈"
Arch = "󰣇"
Fedora = "󰣛"
Debian = "󰣚"
Alpine = ""
{{- else }}
# nerd_font = false: ASCII labels for terminals that can't render glyphs.
Macos = "mac"
Linux = "linux"
Ubuntu = "ubuntu"
Arch = "arch"
Fedora = "fedora"
Debian = "debian"
Alpine = "alpine"
{{- end }}

[username]
# Show only when SSH'd into a remote box or running as root — hide on the
# local primary account where the username adds no info.
show_always = false
style_user = "fg:lavender"
style_root = "bold fg:red"
format = '[$user]($style)'

[hostname]
ssh_only = true
style = "fg:teal"
format = '[@$hostname]($style) '

[directory]
style = "bold fg:sky"
format = '[$path]($style) '
truncation_length = 3
truncate_to_repo = true
truncation_symbol = "…/"

{{- if .nerd_font }}
[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = "󰝚 "
"Pictures" = " "
"Developer" = "󰲋 "
{{- end }}

[git_branch]
style = "fg:mauve"
format = '\[[on $branch]($style)\] '

[git_status]
style = "fg:peach"
format = '(\[[$all_status$ahead_behind]($style)\] )'

[nodejs]
style = "fg:green"
format = '\[[via Node $version]($style)\] '

[bun]
style = "fg:flamingo"
format = '\[[via Bun $version]($style)\] '

[python]
style = "fg:yellow"
format = '\[[via Python $version$virtualenv]($style)\] '

[rust]
style = "fg:peach"
format = '\[[via Rust $version]($style)\] '

[golang]
style = "fg:teal"
format = '\[[via Go $version]($style)\] '

[java]
style = "fg:red"
format = '\[[via Java $version]($style)\] '

[kotlin]
style = "fg:lavender"
format = '\[[via Kotlin $version]($style)\] '

[haskell]
style = "fg:mauve"
format = '\[[via Haskell $version]($style)\] '

[php]
style = "fg:lavender"
format = '\[[via PHP $version]($style)\] '

[c]
style = "fg:green"
format = '\[[via C $version]($style)\] '

[docker_context]
style = "fg:blue"
format = '\[[via Docker $context]($style)\] '

[conda]
style = "fg:sapphire"
format = '\[[via Conda $environment]($style)\] '
ignore_base = false

[cmd_duration]
min_time = 2000
style = "fg:yellow"
format = '\[[took $duration]($style)\] '

[time]
disabled = false
time_format = "%H:%M"
style = "fg:overlay1"
{{- if .nerd_font }}
format = '\[[󰥔 $time]($style)\]'
{{- else }}
format = '\[[$time]($style)\]'
{{- end }}

[line_break]
disabled = false

[character]
success_symbol = '[❯](bold fg:green)'
error_symbol = '[❯](bold fg:red)'
vimcmd_symbol = '[❮](bold fg:green)'
vimcmd_replace_one_symbol = '[❮](bold fg:lavender)'
vimcmd_replace_symbol = '[❮](bold fg:lavender)'
vimcmd_visual_symbol = '[❮](bold fg:yellow)'

[palettes.catppuccin_mocha]
rosewater = "#f5e0dc"
flamingo = "#f2cdcd"
pink = "#f5c2e7"
mauve = "#cba6f7"
red = "#f38ba8"
maroon = "#eba0ac"
peach = "#fab387"
yellow = "#f9e2af"
green = "#a6e3a1"
teal = "#94e2d5"
sky = "#89dceb"
sapphire = "#74c7ec"
blue = "#89b4fa"
lavender = "#b4befe"
text = "#cdd6f4"
subtext1 = "#bac2de"
subtext0 = "#a6adc8"
overlay2 = "#9399b2"
overlay1 = "#7f849c"
overlay0 = "#6c7086"
surface2 = "#585b70"
surface1 = "#45475a"
surface0 = "#313244"
base = "#1e1e2e"
mantle = "#181825"
crust = "#11111b"
