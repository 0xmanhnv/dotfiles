# ============================================================================
# Ghostty Config — cross-OS (macOS + Linux)
# ============================================================================
# Reload: macOS Cmd+Shift+, / Linux Ctrl+Shift+,
# Show all options: ghostty +show-config --default --docs
# List themes: ghostty +list-themes

# ----- Theme & Appearance ---------------------------------------------------
# Auto-switch theme based on OS light/dark mode (macOS Appearance / Linux GTK).
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Minimum contrast ratio to keep text readable
minimum-contrast = 1.1

# ----- Font -----------------------------------------------------------------
{{ if .nerd_font -}}
font-family = JetBrainsMono Nerd Font
{{- else -}}
# nerd_font = false — fall back to a generic monospace family. Set per-machine
# in ~/.config/chezmoi/chezmoi.toml ([data] nerd_font = false) on terminals
# without the Nerd Font installed.
font-family = JetBrains Mono
{{- end }}
font-size = 14
font-thicken = true

# Disable ligatures (e.g. => rendered as arrow)
# font-feature = -liga, -calt, -dlig

# ----- Window ---------------------------------------------------------------
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-save-state = always
window-new-tab-position = end

# ----- Background -----------------------------------------------------------
background-opacity = 1
background-blur = 20

# ----- Cursor & Mouse -------------------------------------------------------
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ----- Shell & Scrollback ---------------------------------------------------
scrollback-limit = 10000000
shell-integration = detect
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
# confirm-close-surface = false

# ----- Quick Terminal (drop-down, Quake-style) -----------------------------
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15
quick-terminal-autohide = true
quick-terminal-size = 25%

# ----- Tab navigation (cross-OS — Ctrl works on both) ----------------------
keybind = ctrl+shift+left=move_tab:-1
keybind = ctrl+shift+right=move_tab:1

{{ if eq .chezmoi.os "darwin" -}}
# ============================================================================
# macOS-specific
# ============================================================================
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
quit-after-last-window-closed = true
maximize = true

# Quick terminal toggle: Cmd-`
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Optional Cmd-based bindings (uncomment to enable)
# keybind = cmd+s=text:\x1b:w\n
# keybind = cmd+left=goto_split:left
# keybind = cmd+right=goto_split:right
# keybind = cmd+up=goto_split:up
# keybind = cmd+down=goto_split:down
# keybind = cmd+shift+equal=equalize_splits
{{ else if eq .chezmoi.os "linux" -}}
# ============================================================================
# Linux-specific (GTK)
# ============================================================================
# Linux doesn't have Cmd; remap macOS Cmd-* equivalents to Ctrl-*.
# Quick terminal toggle: Ctrl-`
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# GTK-only options can go here, e.g.:
# gtk-titlebar = true
# gtk-tabs-location = top
# linux-cgroup = true
{{ end -}}
