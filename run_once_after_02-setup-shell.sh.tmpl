#!/usr/bin/env bash
# TPM is installed by dot_tmux.conf's own bootstrap block on first tmux launch
# (see the `if "test ! -d ~/.tmux/plugins/tpm" ...` line at the bottom of that
# file), so we don't duplicate it here.
set -euo pipefail

# Minimal Docker images and CI runners don't always export USER/SHELL —
# derive them defensively so `set -u` doesn't abort.
me="${USER:-$(id -un)}"
current_shell="${SHELL:-}"

# Compare by basename + check the actual passwd entry, not by full path:
# - $SHELL might be /bin/zsh (system) while command -v finds /opt/homebrew/
#   bin/zsh (brew) — both ARE zsh, but a path-equality check would falsely
#   flag the system one as wrong and trigger chsh on every apply
# - $SHELL only reflects the parent process; the login shell of record lives
#   in /etc/passwd (Linux) or Directory Services (macOS). Read that.
ZSH_PATH="$(command -v zsh || true)"
if [[ "$(uname -s)" == "Darwin" ]]; then
  passwd_shell="$(dscl . -read "/Users/$me" UserShell 2>/dev/null | awk '{print $2}')"
else
  passwd_shell="$(getent passwd "$me" 2>/dev/null | cut -d: -f7)"
fi
passwd_basename="$(basename "${passwd_shell:-/bin/sh}")"

if [[ -n "$ZSH_PATH" && "$passwd_basename" != "zsh" ]]; then
  echo "==> Setting zsh as default shell (current: $passwd_shell)"
  if ! grep -qx "$ZSH_PATH" /etc/shells 2>/dev/null; then
    echo "$ZSH_PATH" | sudo tee -a /etc/shells >/dev/null
  fi

  # Try interactive chsh first. If it fails — typically because chezmoi runs
  # without an interactive TTY for the password prompt — fall back to sudo,
  # which bypasses the user-password requirement and reuses the cached sudo
  # timestamp from the apt/dnf/pacman steps a moment earlier.
  if ! chsh -s "$ZSH_PATH" 2>/dev/null; then
    echo "==> chsh needed elevation, retrying via sudo"
    sudo chsh -s "$ZSH_PATH" "$me" || true
  fi

  # Re-read the passwd entry to verify the change actually stuck.
  if [[ "$(uname -s)" == "Darwin" ]]; then
    current="$(dscl . -read "/Users/$me" UserShell 2>/dev/null | awk '{print $2}')"
  else
    current="$(getent passwd "$me" | cut -d: -f7)"
  fi

  if [[ "$(basename "${current:-/bin/sh}")" != "zsh" ]]; then
    echo "WARNING: login shell is still '$current', not a zsh." >&2
    echo "  Run manually:  chsh -s '$ZSH_PATH'" >&2
  else
    echo "==> Default shell set to zsh (effective on next login)"
  fi
fi
