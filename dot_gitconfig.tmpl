[user]
	name = {{ .name }}
	email = {{ .email }}

# Use HTTPS for clone/fetch (no auth needed for public repos), SSH for push.
# `insteadOf` would force SSH everywhere and break tools that auto-clone via
# HTTPS (e.g., lazy.nvim) on machines without an SSH key configured yet.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true
	followTags = true

[fetch]
	prune = true

[branch]
	# `git branch`: most recently touched first
	sort = -committerdate

[tag]
	# v1.10 sorts after v1.9, not after v1.1
	sort = version:refname

[column]
	ui = auto

[commit]
	# Show the diff below the message in the commit editor
	verbose = true

[rerere]
	# Remember how a conflict was resolved and replay it next time
	enabled = true

[help]
	# `git stauts` -> "did you mean status? [y/N]"
	autocorrect = prompt

[core]
	editor = nvim
	# delta is installed by Brewfile / packages/*.txt. If it's missing on a
	# fresh machine before run_once installs run, git silently skips paging
	# and falls back to plain stdout (still readable, no hard error).
	pager = delta
	excludesfile = ~/.gitignore_global

[color]
	ui = auto

[diff]
	algorithm = histogram
	colorMoved = default
	renames = copies

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	hyperlinks = true
	# Catppuccin to match Ghostty / Neovim / starship. Mocha by default;
	# ~/.config/zsh/00-env.zsh exports DELTA_FEATURES=+catppuccin-latte
	# when the OS is in light mode. Theme names are bat's (`bat --list-themes`).
	features = catppuccin-mocha

[delta "catppuccin-mocha"]
	syntax-theme = Catppuccin Mocha

[delta "catppuccin-latte"]
	syntax-theme = Catppuccin Latte

[merge]
	conflictstyle = zdiff3

[rebase]
	autoStash = true
	# Stacked branches pointing into the rebased range follow along
	updateRefs = true

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	cm = commit -m
	lg = log --oneline --graph --decorate --all
	last = log -1 HEAD --stat
	unstage = reset HEAD --
	amend = commit --amend --no-edit

{{ if eq .chezmoi.os "darwin" -}}
[credential]
	helper = osxkeychain
{{ else -}}
[credential]
	helper = cache --timeout=3600
{{- end }}

# Per-machine overrides (work email, signing key, extra credential helpers...)
# live in ~/.gitconfig.local: untracked, so `chezmoi apply` never clobbers
# them. Included last so its values win; a missing file is silently ignored.
#   [user]
#   	email = me@work.example
[include]
	path = ~/.gitconfig.local
