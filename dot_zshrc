# ==============================================================================
# .zshrc — modular loader
#
# Real config lives in ~/.config/zsh/*.zsh, sourced in lexical order:
#   00-env.zsh       env vars (no PATH, no tool init)
#   10-path.zsh      common PATH (cross-OS)
#   20-tools.zsh     tool init with [[ -s ]] / command -v guards
#   30-aliases.zsh   aliases with [[ -x ]] guards
#   40-darwin.zsh    macOS-only (managed by chezmoiignore on Linux)
#   40-linux.zsh     Linux-only (managed by chezmoiignore on macOS)
#
# Machine-specific overrides go in ~/.zshrc.local (not tracked).
# ==============================================================================

# === Banner ===
GREEN="\033[1;32m"; YELLOW="\033[1;33m"; RED="\033[1;31m"; RESET="\033[0m"
cat <<'EOF'
                                               _oo0oo_
                                              o8888888o
                                              88" . "88
                                              (| -_- |)
                                              0\  =  /0
                                            ___/`---'\___
                                          .' \|     |// '.
                                         / \|||  :  |||// \
                                        / _||||| -:- |||||- \
                                       |   | \  -  /// |   |
                                       | \_|  ''\---/''  |_/ |
                                       \  .-\__  '-'  ___/-. /
                                     ___'. .'  /--.--\  `. .'___
                                  ."" '<  `.___\_<|>_/___.' >' "".
                                 | | :  `- \`.;`\ _ /`;.`/ - ` : | |
                                 \  \ `_.   \_ __\ /__ _/   .-` /  /
                             =====`-.____`.___ \_____/___.-`___.-'=====
                                               `=---='

                             ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
EOF
echo -e "                                ${GREEN}Buddha Bless:${RESET} ${RED}Critical ${YELLOW}Bugs Incoming${RESET}"

# === Base PATH (before OMZ) ===
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

# === Oh My Zsh ===
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting history-substring-search)
[[ -s "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# === Modular config ===
# Anonymous function so `null_glob` is local: empty glob is silently skipped.
# Errors during source are surfaced (instead of silently breaking subsequent files).
() {
  setopt local_options null_glob
  for f in "$HOME/.config/zsh/"*.zsh; do
    source "$f" || print -u2 "zshrc: error sourcing ${f/#$HOME/~}"
  done
}

# === Machine-specific overrides (not tracked) ===
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
